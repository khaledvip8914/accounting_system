generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client_v9"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String    @id @default("default")
  name               String
  nameAr             String?
  phone              String?
  email              String?
  subscriptionStatus String    @default("Active") // Active, Suspended, Expired
  subscriptionEndsAt DateTime?
  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  customers           Customer[]
  suppliers           Supplier[]
  warehouses          Warehouse[]
  products            Product[]
  categories          Category[]
  salesInvoices       SalesInvoice[]
  purchaseInvoices    PurchaseInvoice[]
  stockTransfers      StockTransfer[]
  inventoryLogs       InventoryLog[]
  accounts            Account[]
  journalVouchers     JournalVoucher[]
  transactionVouchers TransactionVoucher[]
  companyProfiles     CompanyProfile[]
  salesQuotations     SalesQuotation[]
  unitOfMeasures      UnitOfMeasure[]
  costCenters         CostCenter[]
  productionOrders    ProductionOrder[]
  users               User[]
  roles               Role[]
  employees           Employee[]
  disposalVouchers    DisposalVoucher[]
  purchaseOrders      PurchaseOrder[]
  warehouseStocks     WarehouseStock[]
  employeeFinancialMoves EmployeeFinancialMove[]
  salaryPayments      SalaryPayment[]
  employeeLoans       EmployeeLoan[]
  currencies          Currency[]
  fixedAssets         FixedAsset[]
  bankAccounts        BankAccount[]
  bankReconciliations BankReconciliation[]
  branches            Branch[]
  taxRates            TaxRate[]
  financialYears      FinancialYear[]
  customFields        Json?
  attachmentSettings  Json?
  paymentTerms        PaymentTerm[]
  paymentMethods      PaymentMethod[]
  productProps        ProductCharacteristic[]
  employeeAttendances EmployeeAttendance[]
}

model Branch {
  id                 String   @id @default(cuid())
  companyId          String   @default("default")
  company            Company  @relation(fields: [companyId], references: [id])
  name               String
  nameAr             String?
  isMain             Boolean  @default(false)
  address            String?
  taxNumber          String?
  commercialRegistry String?
  workLat            Float?   // خط العرض لمقر الفرع
  workLng            Float?   // خط الطول لمقر الفرع
  workRadius         Float?   @default(100) // نطاق الحضور المسموح بالمتر
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users               User[]
  warehouses          Warehouse[]
  salesInvoices       SalesInvoice[]
  purchaseInvoices    PurchaseInvoice[]
  salesQuotations     SalesQuotation[]
  purchaseOrders      PurchaseOrder[]
  journalVouchers     JournalVoucher[]
  transactionVouchers TransactionVoucher[]
  employees           Employee[]
  salaryPayments      SalaryPayment[]
  products            Product[]
  categories          Category[]
  units               UnitOfMeasure[]
  costCenters         CostCenter[]
  productionOrders    ProductionOrder[]
  disposalVouchers    DisposalVoucher[]
}

model SubscriptionPlan {
  id          String    @id @default(cuid())
  name        String    // Basic, Professional, Advanced
  nameAr      String?   // الأساسية، الاحترافية، المتقدمة
  price       Float     @default(0)
  
  // Limits
  maxBranches Int       @default(1)
  maxUsers    Int       @default(1)
  
  // Features (Access flags)
  hasZatcaPhase2        Boolean @default(false)
  hasSalesAndPurchases  Boolean @default(false)
  hasBankReconciliation Boolean @default(false)
  hasUserPermissions    Boolean @default(false)
  hasFixedAssets        Boolean @default(false)
  hasMultiCurrency      Boolean @default(false)
  hasAdvancedReports    Boolean @default(false)
  hasWhatsApp           Boolean @default(false)
  hasHumanResources     Boolean @default(false)
  hasApiIntegration     Boolean @default(false)
  hasAnalysisDimensions Boolean @default(false)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  companies   Company[]
}

model Customer {
  companyId          String           @default("default")
  company            Company          @relation(fields: [companyId], references: [id])
  id                 String           @id @default(cuid())
  code               String           
  name               String
  nameAr             String?
  email              String?
  phone              String?
  address            String?
  streetName         String?
  buildingNumber     String?
  city               String?
  district           String?
  postalCode         String?
  taxNumber          String?
  commercialRegistry String?
  balance            Float            @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  invoices           SalesInvoice[]
  quotations         SalesQuotation[]
  customFields       Json?
  @@unique([companyId, code])
}

model Supplier {
  companyId          String              @default("default")
  company            Company             @relation(fields: [companyId], references: [id])
  id                 String              @id @default(cuid())
  code               String              
  name               String
  nameAr             String?
  email              String?
  phone              String?
  address            String?
  taxNumber          String?
  commercialRegistry String?
  balance            Float               @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  invoices           PurchaseInvoice[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  products           Product[]           @relation("ProductSupplier")
  customFields       Json?
  @@unique([companyId, code])
}

model Warehouse {
  companyId        String            @default("default")
  company          Company           @relation(fields: [companyId], references: [id])
  id               String            @id @default(cuid())
  code             String            
  name             String
  nameAr           String?
  location         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  branchId         String?
  branch           Branch?           @relation(fields: [branchId], references: [id])
  inventoryLogs    InventoryLog[]
  productionOrders ProductionOrder[]
  purchases        PurchaseInvoice[]
  invoices         SalesInvoice[]
  quotations       SalesQuotation[]
  transfersTo      StockTransfer[]   @relation("ToWarehouse")
  transfersFrom    StockTransfer[]   @relation("FromWarehouse")
  stockItems       WarehouseStock[]
  disposalVouchers DisposalVoucher[]
  purchaseOrders   PurchaseOrder[]
  @@unique([companyId, code])
}

model WarehouseStock {
  companyId   String    @default("default")
  company     Company   @relation(fields: [companyId], references: [id])
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Float     @default(0)
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, productId])
}

model Product {
  companyId          String                @default("default")
  company            Company               @relation(fields: [companyId], references: [id])
  id                 String                @id @default(cuid())
  sku                String                
  name               String
  nameAr             String?
  description        String?
  category           String?
  categoryId         String?
  categoryRef        Category?             @relation(fields: [categoryId], references: [id])
  classification     String                @default("Finished Product")
  unit               String                @default("pc")
  unitId             String?
  taxCategory        String                @default("S")
  costPrice          Float                 @default(0)
  salePrice          Float                 @default(0)
  stockQuantity      Float                 @default(0)
  reorderPoint       Float                 @default(0)
  caloriesPer100g    Float                 @default(0)
  expiryDate         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  unitQuantity       Float                 @default(1)
  subUnitId          String?
  costCenters        CostCenter[]
  costCenterItems    CostCenterItem[]
  inventoryLogs      InventoryLog[]
  items              InvoiceItem[]
  subUnitRef         UnitOfMeasure?        @relation("SubUnit", fields: [subUnitId], references: [id])
  unitRef            UnitOfMeasure?        @relation("MainUnit", fields: [unitId], references: [id])
  productionOrders   ProductionOrder[]     @relation("FinishedProduct")
  usages             ProductionOrderItem[] @relation("RawMaterialUsage")
  purchaseItems      PurchaseItem[]
  quotationItems     QuotationItem[]
  transfers          StockTransferItem[]
  warehouseStocks    WarehouseStock[]
  disposalVouchers   DisposalVoucher[]
  purchaseOrderItems PurchaseOrderItem[]
  supplierId         String?
  supplier           Supplier?             @relation("ProductSupplier", fields: [supplierId], references: [id])
  branchId           String?
  branch             Branch?               @relation(fields: [branchId], references: [id])
  customFields       Json?
  @@unique([companyId, sku])
}

model Category {
  companyId String    @default("default")
  company   Company   @relation(fields: [companyId], references: [id])
  id        String    @id @default(cuid())
  name      String    
  nameAr    String?
  products  Product[]
  branchId  String?
  branch    Branch?   @relation(fields: [branchId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@unique([companyId, branchId, name])
}

model SalesInvoice {
  companyId        String          @default("default")
  company          Company         @relation(fields: [companyId], references: [id])
  id               String          @id @default(cuid())
  invoiceNumber    String          
  date             DateTime
  customerId       String
  warehouseId      String?
  branchId         String?
  branch           Branch?         @relation(fields: [branchId], references: [id])
  totalAmount      Float
  taxAmount        Float           @default(0)
  discount         Float           @default(0)
  netAmount        Float
  status           String
  isTaxInclusive   Boolean         @default(false)
  journalVoucherId String?
  invoiceType      String          @default("388") // 388: Invoice, 381: Credit Note, 383: Debit Note
  referenceId      String?         // References the original invoice if it's a Credit/Debit Note
  currency         String?         @default("SAR")
  exchangeRate     Float           @default(1.0)

  // ZATCA Invoice Fields
  zatcaUuid               String?
  zatcaInvoiceHash        String?  @db.Text
  zatcaPreviousHash       String?  @db.Text
  zatcaCryptographicStamp String?  @db.Text
  zatcaQrCode             String?  @db.Text
  zatcaStatus             String   @default("Pending") // Pending, Reported, Cleared, Failed
  zatcaXml                String?  @db.Text
  zatcaErrorLogs          String?  @db.Text
  zatcaReportedAt         DateTime?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  items            InvoiceItem[]
  journalVoucher   JournalVoucher? @relation(fields: [journalVoucherId], references: [id])
  warehouse        Warehouse?      @relation(fields: [warehouseId], references: [id])
  customer         Customer        @relation(fields: [customerId], references: [id])
  quotation        SalesQuotation? @relation("QuotationToInvoice")
  notes            String?         @db.Text
  paymentMethodId  String?
  paymentMethod    PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  customFields     Json?
  dimensionValues  Json?
  @@unique([companyId, invoiceNumber])
}

model PurchaseInvoice {
  companyId        String          @default("default")
  company          Company         @relation(fields: [companyId], references: [id])
  id               String          @id @default(cuid())
  invoiceNumber    String          
  date             DateTime
  supplierId       String?
  warehouseId      String?
  branchId         String?
  branch           Branch?         @relation(fields: [branchId], references: [id])
  totalAmount      Float
  taxAmount        Float           @default(0)
  discount         Float           @default(0)
  netAmount        Float
  status           String
  isTaxInclusive   Boolean         @default(false)
  journalVoucherId String?
  attachmentUrl    String?
  currency         String?         @default("SAR")
  exchangeRate     Float           @default(1.0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  journalVoucher   JournalVoucher? @relation(fields: [journalVoucherId], references: [id])
  warehouse        Warehouse?      @relation(fields: [warehouseId], references: [id])
  supplier         Supplier?       @relation(fields: [supplierId], references: [id])
  items            PurchaseItem[]
  customFields     Json?
  dimensionValues  Json?
  @@unique([companyId, invoiceNumber])
}

model InvoiceItem {
  id              String       @id @default(cuid())
  invoiceId       String
  productId       String
  unitId          String?
  quantity        Float
  unitPrice       Float
  total           Float
  dimensionValues Json?
  product         Product      @relation(fields: [productId], references: [id])
  invoice         SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PurchaseItem {
  id              String          @id @default(cuid())
  invoiceId       String
  productId       String
  unitId          String?
  quantity        Float
  unitPrice       Float
  total           Float
  dimensionValues Json?
  product         Product         @relation(fields: [productId], references: [id])
  invoice         PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model StockTransfer {
  companyId       String              @default("default")
  company         Company             @relation(fields: [companyId], references: [id])
  id              String              @id @default(cuid())
  transferNumber  String              
  date            DateTime            @default(now())
  fromWarehouseId String
  toWarehouseId   String
  status          String              @default("Completed")
  notes           String?
  createdAt       DateTime            @default(now())
  toWarehouse     Warehouse           @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  fromWarehouse   Warehouse           @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  items           StockTransferItem[]
  attachmentUrl   String?
  receiverAttachmentUrl String?
  @@unique([companyId, transferNumber])
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  productId  String
  quantity   Float
  product    Product       @relation(fields: [productId], references: [id])
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

model InventoryLog {
  companyId   String     @default("default")
  company     Company    @relation(fields: [companyId], references: [id])
  id          String     @id @default(cuid())
  productId   String
  warehouseId String?
  unitId      String?
  unitName    String?
  date        DateTime   @default(now())
  type        String
  quantity    Float
  referenceId String?
  description String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  product     Product    @relation(fields: [productId], references: [id])
}

model Account {
  companyId       String               @default("default")
  company         Company              @relation(fields: [companyId], references: [id])
  id              String               @id @default(cuid())
  code            String               
  name            String
  nameAr          String?
  type            String
  nature          String               @default("Debit")
  description     String?
  parentId        String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  parent          Account?             @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[]            @relation("AccountHierarchy")
  bankAccounts    BankAccount[]
  entries         JournalEntry[]
  primaryVouchers TransactionVoucher[] @relation("PrimaryAccount")
  paymentMethods  PaymentMethod[]
  relatedVouchers TransactionVoucher[] @relation("RelatedAccount")
  @@unique([companyId, code])
}

model JournalVoucher {
  companyId          String              @default("default")
  company            Company             @relation(fields: [companyId], references: [id])
  id                 String              @id @default(cuid())
  reference          String              
  date               DateTime
  description        String
  status             String              @default("Draft")
  branchId           String?
  branch             Branch?             @relation(fields: [branchId], references: [id])
  createdAt          DateTime            @default(now())
  entries            JournalEntry[]
  purchaseInvoices   PurchaseInvoice[]
  invoices           SalesInvoice[]
  transactionVoucher TransactionVoucher?
  salaryPayments     SalaryPayment[]
  employeeFinancialMoves EmployeeFinancialMove[]
  depreciationSchedules DepreciationSchedule[]
  currency           String?             @default("SAR")
  exchangeRate       Float               @default(1.0)
  @@unique([companyId, reference])
}

model JournalEntry {
  id               String          @id @default(cuid())
  date             DateTime
  description      String
  accountId        String
  debit            Float           @default(0)
  credit           Float           @default(0)
  reference        String?
  journalVoucherId String?
  createdAt        DateTime        @default(now())
  journalVoucher   JournalVoucher? @relation(fields: [journalVoucherId], references: [id], onDelete: Cascade)
  account          Account         @relation(fields: [accountId], references: [id])
  dimensionValues  Json?
}

model TransactionVoucher {
  companyId        String          @default("default")
  company          Company         @relation(fields: [companyId], references: [id])
  id               String          @id @default(cuid())
  voucherNumber    String          
  type             String
  date             DateTime
  amount           Float
  description      String?
  primaryAccountId String
  relatedAccountId String
  journalVoucherId String?         @unique
  branchId         String?
  branch           Branch?         @relation(fields: [branchId], references: [id])
  currency         String?         @default("SAR")
  exchangeRate     Float           @default(1.0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  primaryAccount   Account         @relation("PrimaryAccount", fields: [primaryAccountId], references: [id])
  relatedAccount   Account         @relation("RelatedAccount", fields: [relatedAccountId], references: [id])
  journalVoucher   JournalVoucher? @relation(fields: [journalVoucherId], references: [id])
  dimensionValues  Json?
  @@unique([companyId, voucherNumber])
}

model CompanyProfile {
  companyId           String   @default("default")
  company             Company  @relation(fields: [companyId], references: [id])
  id                  String   @id @default("default")
  name                String   @default("My Company")
  nameAr              String?  @default("شركتي")
  email               String?
  phone               String?
  logo                String?
  currency            String   @default("SAR")
  taxNumber           String?
  commercialRegister  String?
  streetName          String?
  buildingNumber      String?
  city                String?
  district            String?
  postalCode          String?
  country             String   @default("SA")
  taxSupplyDateType   String   @default("issue")
  separateTaxAccounts Boolean  @default(false)
  
  // ZATCA Integration Fields
  zatcaEnvironment    String   @default("Sandbox") // Sandbox, Simulation, Production
  zatcaPrivateKey     String?  @db.Text
  zatcaPublicKey      String?  @db.Text
  zatcaCsid           String?  @db.Text
  zatcaSecret         String?
  zatcaComplianceStatus String @default("Not Onboarded") // Not Onboarded, CSID Issued, Production Ready
  apiToken            String?  @unique
  
  updatedAt           DateTime @updatedAt
}

model SalesQuotation {
  companyId            String          @default("default")
  company              Company         @relation(fields: [companyId], references: [id])
  id                   String          @id @default(cuid())
  quotationNumber      String          
  date                 DateTime
  validUntil           DateTime?
  customerId           String
  warehouseId          String?
  totalAmount          Float
  taxAmount            Float           @default(0)
  discount             Float           @default(0)
  netAmount            Float
  status               String          @default("Draft")
  isTaxInclusive       Boolean         @default(false)
  branchId             String?
  branch               Branch?         @relation(fields: [branchId], references: [id])
  convertedToInvoiceId String?         @unique
  currency             String?         @default("SAR")
  exchangeRate         Float           @default(1.0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  items                QuotationItem[]
  convertedTo          SalesInvoice?   @relation("QuotationToInvoice", fields: [convertedToInvoiceId], references: [id])
  customer             Customer        @relation(fields: [customerId], references: [id])
  warehouse            Warehouse?      @relation(fields: [warehouseId], references: [id])
  @@unique([companyId, quotationNumber])
}

model QuotationItem {
  id              String         @id @default(cuid())
  quotationId     String
  productId       String
  quantity        Float
  unitPrice       Float
  total           Float
  dimensionValues Json?
  quotation       SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id])
}

model UnitOfMeasure {
  companyId        String                @default("default")
  company          Company               @relation(fields: [companyId], references: [id])
  id               String                @id @default(cuid())
  name             String                
  nameAr           String?
  parentUnitId     String?
  conversionFactor Float?                @default(1)
  ccItems          CostCenterItem[]      @relation("CCItemUnit")
  subProducts      Product[]             @relation("SubUnit")
  mainProducts     Product[]             @relation("MainUnit")
  poItems          ProductionOrderItem[] @relation("POItemUnit")
  parentUnit       UnitOfMeasure?        @relation("UnitConversions", fields: [parentUnitId], references: [id])
  childUnits       UnitOfMeasure[]       @relation("UnitConversions")
  branchId         String?
  branch           Branch?               @relation(fields: [branchId], references: [id])
  @@unique([companyId, branchId, name])
}

model CostCenter {
  companyId    String           @default("default")
  company      Company          @relation(fields: [companyId], references: [id])
  id           String           @id @default(cuid())
  code         String           
  name         String
  nameAr       String?
  description  String?
  productId    String?
  quantityUsed Float            @default(0)
  yieldWeight  Float            @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  product      Product?         @relation(fields: [productId], references: [id])
  items        CostCenterItem[]
  branchId     String?
  branch       Branch?          @relation(fields: [branchId], references: [id])
  @@unique([companyId, branchId, code])
}

model CostCenterItem {
  id           String         @id @default(cuid())
  costCenterId String
  productId    String
  unitId       String?
  quantity     Float          @default(0)
  costPrice    Float          @default(0)
  ratio        Float          @default(0)
  product      Product        @relation(fields: [productId], references: [id])
  unit         UnitOfMeasure? @relation("CCItemUnit", fields: [unitId], references: [id])
  costCenter   CostCenter     @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
}

model ProductionOrder {
  companyId   String                @default("default")
  company     Company               @relation(fields: [companyId], references: [id])
  id          String                @id @default(cuid())
  orderNumber String                
  date        DateTime              @default(now())
  productId   String
  quantity    Float                 @default(0)
  warehouseId String
  status      String                @default("Draft")
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  product     Product               @relation("FinishedProduct", fields: [productId], references: [id])
  items       ProductionOrderItem[]
  branchId    String?
  branch      Branch?               @relation(fields: [branchId], references: [id])
  @@unique([companyId, branchId, orderNumber])
}

model ProductionOrderItem {
  id                String          @id @default(cuid())
  productionOrderId String
  productId         String
  unitId            String?
  quantity          Float
  ratio             Float           @default(0)
  costPrice         Float           @default(0)
  product           Product         @relation("RawMaterialUsage", fields: [productId], references: [id])
  unit              UnitOfMeasure?  @relation("POItemUnit", fields: [unitId], references: [id])
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
}

model User {
  companyId         String    @default("default")
  company           Company   @relation(fields: [companyId], references: [id])
  id                String    @id @default(cuid())
  username          String    @unique
  email             String?
  emailVerified     DateTime?
  verificationToken String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  password          String
  name              String?
  role              String    @default("Employee")
  roleId            String?
  roleRef           Role?     @relation(fields: [roleId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  permissions       String?
  branchId          String?
  branch            Branch?   @relation(fields: [branchId], references: [id])
}

model Role {
  companyId   String   @default("default")
  company     Company  @relation(fields: [companyId], references: [id])
  id          String   @id @default(cuid())
  name        String   
  permissions String   @default("{}") // Stores JSON string of permissions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Employee {
  companyId      String                  @default("default")
  company        Company                 @relation(fields: [companyId], references: [id])
  id             String                  @id @default(cuid())
  code           String                  
  name           String
  nameAr         String?
  jobTitle       String?
  jobTitleAr     String?
  department     String?
  basicSalary    Float                   @default(0)
  idNumber       String?
  idExpiry       DateTime?
  joinDate       DateTime                @default(now())
  status         String                  @default("Active")
  phone          String?
  email          String?
  address        String?
  photoUrl       String?
  branchId       String?
  branch         Branch?                 @relation(fields: [branchId], references: [id])
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  financialMoves EmployeeFinancialMove[]
  salaryPayments SalaryPayment[]
  contracts      EmployeeContract[]
  loans          EmployeeLoan[]
  leaves         EmployeeLeave[]
  attendances    EmployeeAttendance[]
  biometricId    String?                 // كود البصمة في جهاز الحضور
  weekendDays    String?                 // أيام العطلة الأسبوعية (e.g. "5,6" أو JSON)
  shiftStart     String?                 @default("09:00") // موعد بداية الدوام (HH:mm)
  shiftEnd       String?                 @default("17:00") // موعد نهاية الدوام (HH:mm)
  workHoursPerDay Float?                 @default(8)       // ساعات العمل اليومية
  workLat        Float?                  // خط العرض لموقع العمل المحدد للموظف
  workLng        Float?                  // خط الطول لموقع العمل المحدد للموظف
  workRadius     Float?                  @default(100) // نطاق السماح بالمتر (Geofence radius)
  appPassword    String?                 // كلمة المرور لتطبيق الهاتف
  deviceId       String?                 // معرّف هاتف الموظف لربط الحساب بجهاز واحد
  allowBiometric Boolean                 @default(true) // السماح بالبصمة الحيوية
  customFields   Json?
  @@unique([companyId, code])
}

model EmployeeContract {
  id              String               @id @default(cuid())
  companyId       String               @default("default")
  employeeId      String
  startDate       DateTime
  endDate         DateTime?
  basicSalary     Float
  status          String               @default("Active") // Active, Terminated, Expired
  allowances      ContractAllowance[]
  deductions      ContractDeduction[]
  employee        Employee             @relation(fields: [employeeId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model ContractAllowance {
  id              String           @id @default(cuid())
  contractId      String
  name            String
  amount          Float
  contract        EmployeeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model ContractDeduction {
  id              String           @id @default(cuid())
  contractId      String
  name            String
  amount          Float
  contract        EmployeeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model EmployeeFinancialMove {
  companyId  String   @default("default")
  company    Company  @relation(fields: [companyId], references: [id])
  id         String   @id @default(cuid())
  employeeId String
  type       String // Advance, Penalty, Reward, Allowance
  amount     Float
  date       DateTime @default(now())
  reason           String?
  status           String   @default("Confirmed")
  includeInPayroll Boolean  @default(true)
  dimensionValues  Json?
  journalVoucherId String?  @unique
  branchId         String?
  createdAt        DateTime @default(now())
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  journalVoucher   JournalVoucher? @relation(fields: [journalVoucherId], references: [id])
}

model SalaryPayment {
  companyId        String          @default("default")
  company          Company         @relation(fields: [companyId], references: [id])
  id               String          @id @default(cuid())
  employeeId       String
  month            Int
  year             Int
  basicSalary      Float
  allowances       Float           @default(0)
  rewards          Float           @default(0)
  advances         Float           @default(0)
  penalties        Float           @default(0)
  netSalary        Float
  status           String          @default("Pending") // Pending, Approved
  notes            String?         @db.Text
  dimensionValues  Json?
  journalVoucherId String?         @unique
  branchId         String?
  branch           Branch?         @relation(fields: [branchId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  employee         Employee        @relation(fields: [employeeId], references: [id])
  journalVoucher   JournalVoucher? @relation(fields: [journalVoucherId], references: [id])

  @@unique([employeeId, month, year])
}

model DisposalVoucher {
  companyId     String    @default("default")
  company       Company   @relation(fields: [companyId], references: [id])
  id            String    @id @default(cuid())
  voucherNumber String    
  date          DateTime  @default(now())
  productId     String
  warehouseId   String
  unitId        String?
  quantity      Float
  reason        String
  notes         String?
  status        String    @default("Confirmed")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  product       Product   @relation(fields: [productId], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  @@unique([companyId, branchId, voucherNumber])
}

model PurchaseOrder {
  companyId      String              @default("default")
  company        Company             @relation(fields: [companyId], references: [id])
  id             String              @id @default(cuid())
  orderNumber    String              
  date           DateTime            @default(now())
  supplierId     String?
  warehouseId    String?
  totalAmount    Float
  taxAmount      Float               @default(0)
  discount       Float               @default(0)
  netAmount      Float
  status         String              @default("Pending") // Pending, Ordered, Closed, Cancelled
  isTaxInclusive Boolean             @default(false)
  notes          String?
  currency       String?             @default("SAR")
  exchangeRate   Float               @default(1.0)
  branchId       String?
  branch         Branch?             @relation(fields: [branchId], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  warehouse      Warehouse?          @relation(fields: [warehouseId], references: [id])
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])
  items          PurchaseOrderItem[]
  @@unique([companyId, orderNumber])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  orderId         String
  productId       String
  unitId          String?
  supplierId      String?
  quantity        Float
  unitPrice       Float
  total           Float
  dimensionValues Json?
  product         Product       @relation(fields: [productId], references: [id])
  supplier        Supplier?     @relation(fields: [supplierId], references: [id])
  order           PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Currency {
  companyId    String    @default("default")
  company      Company   @relation(fields: [companyId], references: [id])
  id           String    @id @default(cuid())
  code         String    // e.g. USD, EUR
  name         String    // US Dollar
  nameAr       String?
  exchangeRate Float     @default(1.0)
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([companyId, code])
}

model FixedAsset {
  companyId           String    @default("default")
  company             Company   @relation(fields: [companyId], references: [id])
  id                  String    @id @default(cuid())
  code                String
  name                String
  nameAr              String?
  description         String?
  purchaseDate        DateTime
  purchasePrice       Float
  salvageValue        Float     @default(0)
  usefulLifeYears     Float
  depreciationMethod  String    @default("Straight Line") // Straight Line, Declining Balance
  accumulatedDepreciation Float @default(0)
  netBookValue        Float
  status              String    @default("Active") // Active, Disposed, Sold
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  depreciationSchedules DepreciationSchedule[]

  @@unique([companyId, code])
}

model DepreciationSchedule {
  id               String      @id @default(cuid())
  assetId          String
  date             DateTime
  amount           Float
  accumulatedTotal Float
  journalVoucherId String?     @unique
  createdAt        DateTime    @default(now())

  asset            FixedAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  journalVoucher   JournalVoucher? @relation(fields: [journalVoucherId], references: [id])
}

model BankAccount {
  companyId       String               @default("default")
  company         Company              @relation(fields: [companyId], references: [id])
  id              String               @id @default(cuid())
  accountNumber   String
  bankName        String
  bankNameAr      String?
  currency        String               @default("SAR")
  initialBalance  Float                @default(0)
  currentBalance  Float                @default(0)
  linkedAccountId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  
  linkedAccount   Account?             @relation(fields: [linkedAccountId], references: [id])
  statements      BankStatement[]
  reconciliations BankReconciliation[]

  @@unique([companyId, accountNumber])
}

model BankStatement {
  id              String   @id @default(cuid())
  bankAccountId   String
  date            DateTime
  description     String
  reference       String?
  withdrawal      Float    @default(0)
  deposit         Float    @default(0)
  balance         Float
  isReconciled    Boolean  @default(false)
  createdAt       DateTime @default(now())

  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  reconciliationItems BankReconciliationItem[]
}

model BankReconciliation {
  companyId       String               @default("default")
  company         Company              @relation(fields: [companyId], references: [id])
  id              String               @id @default(cuid())
  bankAccountId   String
  statementDate   DateTime
  statementBalance Float
  systemBalance    Float
  difference       Float
  status           String              @default("Draft") // Draft, Completed
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  bankAccount      BankAccount         @relation(fields: [bankAccountId], references: [id])
  items            BankReconciliationItem[]
}

model BankReconciliationItem {
  id                String             @id @default(cuid())
  reconciliationId  String
  bankStatementId   String?
  systemVoucherId   String?            // Can be JournalVoucher or TransactionVoucher ID
  status            String             @default("Matched") // Matched, Missing in System, Missing in Bank
  notes             String?

  reconciliation    BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  bankStatement     BankStatement?     @relation(fields: [bankStatementId], references: [id])
}

model TaxRate {
  id                  String   @id @default(cuid())
  companyId           String   @default("default")
  company             Company  @relation(fields: [companyId], references: [id])
  name                String
  nameAr              String?
  rate                Float
  code                String   @default("S") // ZATCA code: S, Z, E, O
  exemptionReasonCode String?
  exemptionReasonText String?
  isDefault           Boolean  @default(false)
  isActive            Boolean  @default(true)
  
  outputAccountId     String?
  inputAccountId      String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@unique([companyId, code, rate])
}

model FinancialYear {
  id           String    @id @default(cuid())
  companyId    String
  name         String
  startDate    DateTime
  endDate      DateTime
  status       String    @default("Open") // Open, Closed
  isActive     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company   @relation(fields: [companyId], references: [id])
  @@unique([companyId, name])
}

model CustomField {
  id          String   @id @default(cuid())
  companyId   String
  module      String   // 'Customer', 'Supplier', 'Product', 'SalesInvoice', 'PurchaseInvoice', 'Employee'
  name        String   // 'cf_birthday'
  label       String
  labelAr     String?
  type        String   // 'Text', 'Number', 'Date', 'Select', 'Checkbox'
  options     Json?    // Array of strings if type is 'Select'
  isRequired  Boolean  @default(false)
  showInPrint Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, module, name])
}

model AccountingDimension {
  id          String   @id @default(cuid())
  companyId   String
  name        String   // 'Project', 'Region'
  nameAr      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values      DimensionValue[]

  @@unique([companyId, name])
}

model DimensionValue {
  id          String   @id @default(cuid())
  dimensionId String
  code        String
  name        String
  nameAr      String?
  isActive    Boolean  @default(true)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dimension   AccountingDimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  parent      DimensionValue?     @relation("DimensionHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    DimensionValue[]    @relation("DimensionHierarchy")

  @@unique([dimensionId, code])
}


model PayrollSettings {
  companyId                    String   @id @default("default")
  basicSalaryAccountId         String?
  allowancesAccountId          String?
  deductionsAccountId          String?
  employeeLoansAccountId       String?
  accruedSalariesAccountId     String?
  gosiCompanyExpenseAccountId  String?
  gosiPayableAccountId         String?
  endOfServiceExpenseAccountId String?
  endOfServiceProvisionAccountId String?
  vacationExpenseAccountId     String?
  vacationProvisionAccountId   String?
  
  gosiEmployeeRatio            Float    @default(9.75)
  gosiCompanyRatio             Float    @default(11.75)
  gosiMaxSalary                Float    @default(45000)
  
  defaultAnnualLeaveDays       Int      @default(30)
  enableEndOfServiceProvision  Boolean  @default(false)
  enableVacationProvision      Boolean  @default(false)
  
  payrollCycleStartDay         Int      @default(1)
  payrollCycleEndDay           Int      @default(30)
  defaultPaymentMethod         String   @default("Bank Transfer")
  defaultBankAccountId         String?
  
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model PayrollAllowanceType {
  id               String   @id @default(cuid())
  companyId        String   @default("default")
  name             String
  nameAr           String?
  type             String   // Fixed, Variable
  isGosiTaxable    Boolean  @default(false)
  defaultAmount    Float    @default(0)
  overrideAccountId String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, name])
}

model PayrollDeductionType {
  id               String   @id @default(cuid())
  companyId        String   @default("default")
  name             String
  nameAr           String?
  type             String   // FixedAmount, Days, Hours
  overrideAccountId String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, name])
}

model EmployeeLoan {
  id                String            @id @default(cuid())
  companyId         String            @default("default")
  employeeId        String
  totalAmount       Float
  remainingAmount   Float
  installmentAmount Float
  startMonth        Int
  startYear         Int
  reason            String?
  status            String            @default("Active")
  date              DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company           Company           @relation(fields: [companyId], references: [id])
  employee          Employee          @relation(fields: [employeeId], references: [id])
  installments      LoanInstallment[]
}

model LoanInstallment {
  id        String       @id @default(cuid())
  loanId    String
  month     Int
  year      Int
  amount    Float
  status    String       @default("Pending")
  createdAt DateTime     @default(now())

  loan      EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model EmployeeLeave {
  id          String   @id @default(cuid())
  companyId   String   @default("default")
  employeeId  String
  startDate   DateTime
  endDate     DateTime
  type        String
  status      String   @default("Pending")
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}


model PaymentMethod {
  companyId     String         @default("default")
  company       Company        @relation(fields: [companyId], references: [id])
  id            String         @id @default(cuid())
  name          String
  nameAr        String?
  code          String?
  type          String         @default("Cash") // Cash, Card, Bank, Other
  accountId     String?
  account       Account?       @relation(fields: [accountId], references: [id])
  isActive      Boolean        @default(true)
  isDefault     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  salesInvoices SalesInvoice[]

  @@unique([companyId, name])
}

model PaymentTerm {
  companyId          String    @default("default")
  company            Company   @relation(fields: [companyId], references: [id])
  id                 String    @id @default(cuid())
  name               String
  nameAr             String?
  dueDays            Int
  discountDays       Int       @default(0)
  discountPercentage Float     @default(0)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([companyId, name])
}

model ProductCharacteristic {
  companyId    String    @default("default")
  company      Company   @relation(fields: [companyId], references: [id])
  id           String    @id @default(cuid())
  name         String
  nameAr       String?
  type         String    // text, select, number, boolean
  options      String[]  // Array of strings for select options
  isRequired   Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([companyId, name])
}

model EmployeeAttendance {
  id             String    @id @default(cuid())
  companyId      String    @default("default")
  company        Company   @relation(fields: [companyId], references: [id])
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime  // تاريخ اليوم (منتصف الليل أو تاريخ التسجيل)
  checkIn        DateTime? // وقت تسجيل الحضور
  checkOut       DateTime? // وقت تسجيل الانصراف
  checkInLat     Float?    // خط عرض الحضور
  checkInLng     Float?    // خط طول الحضور
  checkOutLat    Float?    // خط عرض الانصراف
  checkOutLng    Float?    // خط طول الانصراف
  workMinutes    Int       @default(0) // إجمالي دقائق العمل
  lateMinutes    Int       @default(0) // دقائق التأخير
  earlyMinutes   Int       @default(0) // دقائق الانصراف المبكر
  status         String    @default("PRESENT") // PRESENT, ABSENT, LATE, ON_LEAVE, WEEKEND, HALF_DAY
  source         String    @default("MANUAL")  // MANUAL, BIOMETRIC, MOBILE_GPS
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, employeeId, date])
}
